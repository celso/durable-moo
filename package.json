{
  "name": "durable-moo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "build:wasm": "./scripts/build-wasm.sh",
    "build:web": "node scripts/build-web.mjs",
    "check:wasm": "node scripts/smoke-wasm.mjs",
    "check": "tsc --noEmit && tsc -p web/tsconfig.json && tsx --test tests/*.test.ts && node scripts/smoke-wasm.mjs",
    "check:worker": "wrangler deploy --dry-run",
    "deploy": "pnpm run build:wasm && pnpm run check && wrangler deploy",
    "dev": "sh dev.sh",
    "check:tcp": "node scripts/smoke-tcp.mjs",
    "check:browser": "playwright test",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "jsonc-parser": "3.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wrangler": "4.166.0",
    "ws": "8.23.0"
  },
  "dependencies": {
    "rioterm": "0.1.8",
    "string-width": "9.0.0"
  }
}
